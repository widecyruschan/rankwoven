# ── Build stage ──
FROM node:22-alpine AS builder
WORKDIR /workspace

COPY package.json package-lock.json* ./
COPY apps/web/package.json apps/web/package.json
COPY apps/api/package.json apps/api/package.json
COPY apps/worker/package.json apps/worker/package.json
COPY packages/ai-providers/package.json packages/ai-providers/package.json
COPY packages/cms-adapters/package.json packages/cms-adapters/package.json

RUN npm install

COPY . .

# Build shared packages needed by web
RUN npm run build -w @aieo/cms-adapters
RUN npm run build -w @aieo/ai-providers

# Build web (vue-tsc + vite build)
# VITE_API_BASE_URL is inlined by Vite at build time — must point to the public API.
ARG VITE_API_BASE_URL=https://api.rankwoven.com
ENV VITE_API_BASE_URL=$VITE_API_BASE_URL
RUN npm run build -w @aieo/web

# ── Runtime stage ──
FROM nginx:alpine

# Copy custom nginx config
COPY apps/web/nginx.conf /etc/nginx/conf.d/default.conf

# Copy built assets from builder
COPY --from=builder /workspace/apps/web/dist /usr/share/nginx/html

EXPOSE 80

HEALTHCHECK --interval=15s --timeout=5s --retries=3 \
    CMD wget -qO- http://localhost/ || exit 1

CMD ["nginx", "-g", "daemon off;"]
