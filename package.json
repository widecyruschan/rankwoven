{
  "name": "aieo",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "build": "npm run build -w @aieo/cms-adapters && npm run build -w @aieo/api && npm run build -w @aieo/web && npm run build -w @aieo/worker",
    "dev": "npm run build -w @aieo/cms-adapters && npm run dev --workspaces --if-present",
    "lint": "eslint . --ext .ts,.vue --max-warnings 0",
    "test": "npm run test --workspaces --if-present",
    "format": "prettier --write .",
    "docker:up": "docker compose up -d --build",
    "docker:down": "docker compose down"
  },
  "devDependencies": {
    "@eslint/js": "^9.32.0",
    "@types/node": "^22.13.14",
    "eslint": "^9.32.0",
    "eslint-plugin-vue": "^10.3.0",
    "prettier": "^3.6.2",
    "typescript": "^5.8.3",
    "typescript-eslint": "^8.38.0",
    "vitest": "^3.2.4",
    "vue-eslint-parser": "^10.2.0"
  }
}
