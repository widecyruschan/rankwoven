NODE_ENV=development
APP_BASE_URL=http://localhost:5173
API_BASE_URL=http://localhost:3011
VITE_API_BASE_URL=http://localhost:3011
PUBLIC_SITE_URL=https://rankwoven.com
APP_DASHBOARD_URL=https://app.rankwoven.com
PUBLIC_ASSETS_URL=https://assets.rankwoven.com
DATABASE_URL=postgresql://aieo:aieo_password@postgres:5432/aieo
REDIS_URL=redis://redis:6379
JWT_SECRET=replace-with-a-local-secret
# Optional one-time migration key for pre-PH2-04 HMAC password hashes. Set it to the previous JWT secret, then remove after all active users log in.
LEGACY_PASSWORD_HMAC_SECRET=
WORDPRESS_CREDENTIAL_ENCRYPTION_KEY=replace-with-a-local-32-byte-secret
CORS_ORIGINS=http://localhost:5173,http://localhost:8080,http://localhost:8082,https://rankwoven.com,https://www.rankwoven.com,https://app.rankwoven.com
TRUST_PROXY=false
ALLOW_LOCAL_LIGHTHOUSE_FALLBACK=false

AI_TEXT_PROVIDER=wenwen
AI_FALLBACK_TEXT_PROVIDER=wenwen
AI_EMBEDDING_PROVIDER=wenwen
AI_IMAGE_PROVIDER=wenwen
AI_IMAGE_FALLBACK_PROVIDER=wenwen
MEDIA_STORAGE_PROVIDER=qiniu-kodo
IMAGE_OPTIMIZATION_PROVIDER=cloudinary

WENWEN_API_BASE_URL=https://breakout.wenwen-ai.com
WENWEN_API_KEY=
WENWEN_TEXT_MODEL=gpt-4o-mini
WENWEN_EMBEDDING_MODEL=text-embedding-3-small
WENWEN_IMAGE_MODEL=gemini-2.5-flash-image

GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_APPLICATION_CREDENTIALS=
GOOGLE_APPLICATION_CREDENTIALS_JSON=
GOOGLE_APPLICATION_CREDENTIALS_BASE64=

# SerpApi — SEO site audit (free tier: 250 searches/month)
SERPAPI_KEY=
SERPAPI_MONTHLY_LIMIT=250
# Optional free enrichment for long-tail / demand cross-check (keyword research)
BING_WEBMASTER_API_KEY=
BRAVE_SEARCH_API_KEY=
# Used by site audit and as keyword-research fallback when DataForSEO/Semrush fails.
CRUX_API_KEY=
CRUX_API_URL=https://chromeuxreport.googleapis.com/v1/records:queryRecord
SITE_AUDIT_LIGHTHOUSE_ENABLED=true

# Stripe Billing — keep all values server-side. Checkout and subscription changes
# remain disabled until the secret, webhook secret and selected Price ID are set.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_STARTER_MONTHLY=
STRIPE_PRICE_GROWTH_MONTHLY=
STRIPE_PRICE_AGENCY_MONTHLY=
STRIPE_BILLING_PORTAL_CONFIGURATION_ID=

# Rate limiting (requests per time window per IP)
RATE_LIMIT_MAX=100
RATE_LIMIT_TIME_WINDOW_MS=60000

# Keyword volume & difficulty data source selector (define exactly once)
# Supported providers: dataforseo | semrush | generic
KEYWORD_VOLUME_PROVIDER=generic
# DataForSEO: https://api.dataforseo.com/v3
# API key format: login-email:api-password (base64 encoded for Basic auth)
KEYWORD_VOLUME_API_URL=https://api.dataforseo.com/v3
KEYWORD_VOLUME_API_KEY=your-dfseo-email:your-dfseo-api-password
# Ahrefs Keyword Explorer API v3 (independent from KEYWORD_VOLUME_* settings)
AHREFS_KEYWORD_METRICS_ENABLED=false
AHREFS_API_URL=https://api.ahrefs.com/v3/keywords-explorer/overview
AHREFS_API_KEY=
# Ahrefs Site Audit API v3 (platform-managed: customers do not need a Project ID)
AHREFS_SITE_AUDIT_ENABLED=false
AHREFS_SITE_AUDIT_API_URL=https://api.ahrefs.com/v3/site-audit/issues
AHREFS_SITE_AUDIT_PROJECT_ID=
AHREFS_SITE_AUDIT_CRAWL_DATE=
AHREFS_SITE_AUDIT_COMPARISON_DATE=
AHREFS_SITE_AUDIT_AUTO_CREATE=true
AHREFS_MANAGEMENT_API_URL=https://api.ahrefs.com/v3/management/projects
# Semrush API (requires Semrush subscription)
# SEMRUSH_API_URL=https://api.semrush.com/analytics/v1
# SEMRUSH_API_KEY=your-semrush-api-key

QINIU_ACCESS_KEY=
QINIU_SECRET_KEY=
QINIU_BUCKET=
QINIU_REGION=
QINIU_PUBLIC_DOMAIN=
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

MAIL_FROM_NAME=RankWoven
MAIL_FROM_ADDRESS=no-reply@rankwoven.com
SUPPORT_EMAIL=support@rankwoven.com
