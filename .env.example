# SerpApi — SEO site audit (free tier: 250 searches/month)
SERPAPI_KEY=

# Keyword volume & difficulty data sources (choose one)
# Supported providers: dataforseo | ahrefs | semrush | generic
KEYWORD_VOLUME_PROVIDER=generic
# DataForSEO: https://api.dataforseo.com/v3
# API key format: login-email:api-password (base64 encoded for Basic auth)
KEYWORD_VOLUME_API_URL=https://api.dataforseo.com/v3
KEYWORD_VOLUME_API_KEY=your-dfseo-email:your-dfseo-api-password
# Ahrefs API (requires Ahrefs subscription)
# AHREFS_API_URL=https://api.ahrefs.com/v3/keywords-explorer/google-search-volume
# AHREFS_API_KEY=your-ahrefs-api-token
# Semrush API (requires Semrush subscription)
# SEMRUSH_API_URL=https://api.semrush.com/analytics/v1
# SEMRUSH_API_KEY=your-semrush-api-key

